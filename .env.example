# ==============================================================================
# Gayatri Cloud — Environment Configuration Template
# ==============================================================================
# IMPORTANT: DO NOT commit real secrets or production keys to version control.
# Copy this file to `.env` for local development.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Gayatri Cloud API"
APP_VERSION="0.1.0"
API_V1_PREFIX=/api/v1

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL with pgvector)
# Local development default using local postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gayatri_cloud_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Object Storage (AWS S3 / Local Filesystem Adapter)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./local_storage/uploads
AWS_REGION=ap-south-1
AWS_S3_BUCKET=gayatri-cloud-assets-dev
# Optional AWS credentials for staging/production (leave empty locally):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Security & Authentication (JWT)
# Generate a secure 32+ byte random string for local development:
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Gateway Configuration (Server-Side Only - Placeholders)
# Keys are optional locally; mock adapters will be used if keys are absent
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_AI_PROVIDER=mock
