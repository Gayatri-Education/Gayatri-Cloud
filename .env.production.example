# ==============================================================================
# Gayatri Cloud — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit populated values, real API keys, or production passwords to git.
# - Inject values via AWS Systems Manager Parameter Store or AWS Secrets Manager.
# ==============================================================================

# Core Application Settings
APP_ENV=production
DEBUG=false
PORT=8000
ALLOWED_ORIGINS=https://app.gayatri.internal,https://api.gayatri.internal

# Database Configuration (PostgreSQL RDS)
POSTGRES_USER=gayatri_admin
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_GENERATED_PASSWORD_MIN_32_CHARS
POSTGRES_DB=gayatri_cloud
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@rds-endpoint.internal:5432/${POSTGRES_DB}

# Cryptographic Keys (Must be generated with: openssl rand -hex 32)
JWT_SECRET_KEY=REPLACE_WITH_HEX_32_SECRET_FOR_JWT_SIGNING
SECRET_KEY=REPLACE_WITH_HEX_32_SECRET_FOR_AES_256_GCM_VAULT

# Storage Layer Configuration (AWS S3)
STORAGE_BACKEND=s3
S3_BUCKET_NAME=gayatri-cloud-pilot-storage
AWS_REGION=ap-south-1
# When running on EC2, rely on IAM Instance Profile rather than access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Event Telemetry & Archive Configuration
TELEMETRY_ARCHIVE_BUCKET=gayatri-cloud-pilot-archive
TRAINING_GOVERNANCE_DEFAULT=deny_all

# Webhook Secret for Billing Replay Protection
BILLING_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_HMAC_SECRET

# Frontend Public API URL
NEXT_PUBLIC_API_URL=https://api.gayatri.internal
